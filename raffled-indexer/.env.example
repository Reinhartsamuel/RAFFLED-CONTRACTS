# Copy this file to ~/raffled-indexer/.env.local on the VPS and fill in the values.
# Ponder loads .env.local automatically (dotenv); PM2 starts `npm run start`.

# Required: Base Sepolia RPC endpoint for the indexer (get one free at e.g. Alchemy/QuickNode/PublicNode)
PONDER_RPC_URL_84532=https://base-sepolia-rpc.example.com

# Required: Postgres connection string (see one-time VPS setup:
#   sudo -u postgres psql -c "CREATE USER ponder WITH PASSWORD '<password>';"
#   sudo -u postgres psql -c "CREATE DATABASE ponder OWNER ponder;")
DATABASE_URL=postgresql://ponder:change-me@localhost:5432/ponder

# Optional: override the indexed RaffledCore contract address
# (defaults to the Base Sepolia deployment 0xc17eee20B4990021bE9cc8eCB7833706465bb8b9)
# RAFFLED_CORE_ADDRESS=0x...
