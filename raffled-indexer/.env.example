# Copy this file to /home/admin/repos/raffled-contract/raffled-indexer/.env on the VPS
# and fill in the values. The start script loads it via node --env-file.

# Required: Base Sepolia RPC endpoint for the indexer (get one free at e.g. Alchemy/QuickNode/PublicNode)
PONDER_RPC_URL_84532=https://base-sepolia-rpc.example.com

# Required: Postgres connection string (e.g. Aiven):
#   postgres://avnadmin:PASSWORD@HOST.e.aivencloud.com:PORT/raffled-ponder?sslmode=require
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Optional: override the indexed RaffledCore contract address
# (defaults to the Base Sepolia deployment 0xc17eee20B4990021bE9cc8eCB7833706465bb8b9)
# RAFFLED_CORE_ADDRESS=0x...
