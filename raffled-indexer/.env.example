# Copy this file to /home/admin/repos/raffled-contract/raffled-indexer/.env on the VPS
# and fill in the values. The start script loads it via node --env-file.

# Required: Base Sepolia RPC endpoint for the indexer. Must be API-keyed
# (Alchemy/QuickNode/etc) — free public RPCs Cloudflare-ban datacenter IPs.
PONDER_RPC_URL_84532=https://base-sepolia.g.alchemy.com/v2/KEY

# Optional: WebSocket endpoint for realtime newHeads subscription (Ponder
# polls every 1s instead if this is unset). Defaults to PONDER_RPC_URL_84532
# with https:// -> wss://, which is correct for Alchemy.
# PONDER_WS_URL_84532=wss://base-sepolia.g.alchemy.com/v2/KEY

# Required: Postgres connection string (e.g. Aiven):
#   postgres://avnadmin:PASSWORD@HOST.e.aivencloud.com:PORT/raffled-ponder?sslmode=require
# sslmode=require works as-is — ponder.config.ts auto-appends uselibpqcompat=true
# (pg >= 2.x otherwise validates Aiven's private CA and refuses the connection).
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Optional: override the indexed RaffledCore contract address
# (defaults to the Base Sepolia deployment 0xc17eee20B4990021bE9cc8eCB7833706465bb8b9)
# RAFFLED_CORE_ADDRESS=0x...
