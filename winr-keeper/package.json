{
  "name": "winr-keeper",
  "version": "1.0.0",
  "private": true,
  "description": "Keeper service for WinrCore (Robinhood Chain): resolution requester cron + settlement relayer cron.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "once": "node --env-file-if-exists=.env.local src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "start:dist": "node --env-file-if-exists=.env.local dist/index.js",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.9.2"
  }
}
